# High-Level System Architecture — Hospital AI Assistant

direction: right

vars: {
  d2-config: {
    layout-engine: elk
  }
  d2-legend: "Legend" {
    in: {
      label: In/Out
      class: in
    }
    container: "Container" {
      class: cont
    }
    agent: {
      label: Agent
      class: agent
      style: {
        border-radius: 20
        fill: "#42ccf1"
        stroke: "white"
        font-color: "#f5f5f5"
        double-border: true
      }
    }
    code unit: {
      label: Code Unit
      class: code
    }
    llm -> llm: {
      label: Call/Task
      class: call
    }
    tool: {
      label: Tool
      class: tool
      width: 120
      height: 40
    }
  }
}

classes: {
  call: {
    style: {
      animated: true
    }
  }
  agent: {
    style: {
      fill: "#42ccf1"
      stroke: "#eeecec"
      font-color: "#f5f5f5"
      double-border: true
      border-radius: 5
    }
  }
  llm_or_code: {
    style: {
      fill: "white"
      border-radius: 5
      fill: "#42ccf1"
      stroke: "#eeecec"
      font-color: "#f5f5f5"
      double-border: true
    }
  }
  cont: {
    shape: rectangle
    style: {
      fill: "#fafafa"
      stroke: "lightgray"
      border-radius: 5
    }
    width: 300
  }
  cont1: {
    style: {
      fill: "#fff7ec"
      stroke: "#ffc955"
      border-radius: 5
    }
    width: 300
  }
  cont_t: {
    style: {
      fill: "white"
      border-radius: 5
    }
    width: 300
  }
  cont_tools: {
    style: {
      fill: "#fcf7e6"
      stroke: "#f5e617"
      border-radius: 5
    }
    width: 300
  }
  tool: {
    style: {
      fill: "yellow"
    }
    style.border-radius: 10
    width: 120
    height: 40
  }
  out: {
    shape: circle
    width: 60
    height: 60
    style: {
      stroke: "black"
      fill: "white"
      font-color: "black"
      double-border: true
    }
  }
  in: {
    shape: circle
    width: 60
    height: 60
    style: {
      stroke: "black"
      fill: "white"
      font-color: "black"
      double-border: false
    }
  }
  io_call: {
    style: {
      animated: true
    }
  }
  prompt: {
    shape: page
    style: {
      fill: "#E6F7FF"
    }
    width: 60
  }
  response: {
    shape: page
    style: {
      fill: "#E6F7FF"
      double-border: true
    }
    width: 60
  }
  pt: "Prompt Template" {
    shape: page
    width: 60
    style: {
      fill: "#E6F7FF"
      stroke-dash: 2
    }
  }
  code: {
    style: {
      fill: "white"
    }
  }
}

# Root styles
style: {
  fill: white
  border-radius: 2
  shadow: true
  stroke-width: 2
  stroke: lightgray
}

# Global edge styles
(*** -> ***)[*]: {
  style: {
    stroke: "gray"
    stroke-dash: 3
    animated: true
  }
}
(*** <- ***)[*]: {
  style: {
    stroke: red
    stroke-dash: 3
    animated: true
  }
}
(*** <-> ***)[*]: {
  style: {
    stroke: orange
    stroke-dash: 3
    animated: true
  }
}

# ─────────────────────────────────────────────
# Nodes
# ─────────────────────────────────────────────

user: "👤 User" {
  class: in
}

ui: "Chat UI / API Layer\n(Streamlit)" {
  class: cont
}

# ── Input Guardrail ──────────────────────────
input_guard: "Input Guardrail" {
  class: cont

  injection_detect: "Prompt Injection\nDetection" {
    class: agent
  }
  privacy_check: "Privacy Check" {
    class: agent
  }
  scope_filter: "Out-of-Scope\nFilter" {
    class: agent
  }

  injection_detect -> privacy_check -> scope_filter
}

# ── Agent Orchestrator ───────────────────────
orchestrator: "Agent Orchestrator\n(LangGraph StateGraph)" {
  class: cont1

  memory_read: "Read Memory" {
    class: agent
  }
  intent: "Intent Classifier" {
    class: agent
  }
  rewriter: "Query Rewriter" {
    class: agent
  }
  sufficiency: "Sufficiency Check" {
    class: agent
  }
  synthesizer: "Answer Synthesizer" {
    class: agent
  }
  self_check: "Self-Check" {
    class: agent
  }

  memory_read -> intent -> rewriter
  rewriter -> sufficiency: "after retrieval"
  sufficiency -> synthesizer
  synthesizer -> self_check
}

# ── Agentic RAG Pipeline ────────────────────
rag: "Agentic RAG Pipeline" {
  class: cont

  embeddings: "Embedding\n(LiteLLM)" {
    class: code
  }
  chroma: "ChromaDB\nVector Store" {
    class: tool
  }

  embeddings -> chroma: "semantic search"
}

# ── Structured Tools ────────────────────────
tools: "Structured Tools" {
  class: cont_tools

  hospital_db: "Hospital DB\n(SQLite)" {
    class: tool
  }
  appt_api: "Appointment\nMock API" {
    class: tool
  }
}

# ── Output Guardrail ────────────────────────
output_guard: "Output Guardrail" {
  class: cont

  grounding: "Grounding Check" {
    class: agent
  }
  phi_removal: "PHI Removal" {
    class: agent
  }
  disclaimer: "Disclaimer\nInjection" {
    class: agent
  }

  grounding -> phi_removal -> disclaimer
}

# ── Memory System ───────────────────────────
memory: "Memory System" {
  class: cont

  short_term: "Short-term\n(In-memory)" {
    class: code
  }
  long_term: "Long-term Prefs\n(SQLite)" {
    class: tool
  }
  policy: "Memory Policy" {
    class: agent
  }
}

# ── External ────────────────────────────────
audit: "Audit Logger\n(JSONL)" {
  class: code
  shape: page
}

final_answer: "Final\nAnswer" {
  class: out
}

# ─────────────────────────────────────────────
# Connections
# ─────────────────────────────────────────────

user -> ui: "message"
ui -> input_guard
input_guard -> orchestrator: "safe requests"
input_guard -> ui: "blocked → refusal"

orchestrator -> rag: "retrieve"
orchestrator -> tools: "tool query"
orchestrator -> output_guard: "draft answer"
orchestrator -> memory: "read / write"


rag -> orchestrator: "chunks"
tools -> orchestrator: "structured data"
output_guard -> final_answer: "validated"
memory -> orchestrator: "context"

input_guard -> audit: "log"
output_guard -> audit: "log"
tools -> audit: "log"
memory.policy -> audit: "log"
