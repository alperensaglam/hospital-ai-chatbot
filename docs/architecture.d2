# High-Level System Architecture — Hospital AI Assistant

direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
  d2-legend: "Legend" {
    in: {
      label: In/Out
      class: in
    }
    container: "Container" {
      class: cont
    }
    agent: {
      label: Agent
      class: agent
      style: {
        border-radius: 20
        fill: "#42ccf1"
        stroke: "white"
        font-color: "#f5f5f5"
        double-border: true
      }
    }
    code unit: {
      label: Code Unit
      class: code
    }
    llm -> llm: {
      label: Call/Task
      class: call
    }
    tool: {
      label: Tool
      class: tool
      width: 120
      height: 40
    }
  }
}

classes: {
  call: {
    style: {
      animated: true
    }
  }
  agent: {
    style: {
      fill: "#42ccf1"
      stroke: "#eeecec"
      font-color: "#f5f5f5"
      double-border: true
      border-radius: 5
    }
  }
  llm_or_code: {
    style: {
      fill: "white"
      border-radius: 5
      fill: "#42ccf1"
      stroke: "#eeecec"
      font-color: "#f5f5f5"
      double-border: true
    }
  }
  cont: {
    shape: rectangle
    style: {
      fill: "#fafafa"
      stroke: "lightgray"
      border-radius: 5
    }
    width: 300
  }
  cont1: {
    style: {
      fill: "#fff7ec"
      stroke: "#ffc955"
      border-radius: 5
    }
    width: 300
  }
  cont_t: {
    style: {
      fill: "white"
      border-radius: 5
    }
    width: 300
  }
  cont_tools: {
    style: {
      fill: "#fcf7e6"
      stroke: "#f5e617"
      border-radius: 5
    }
    width: 300
  }
  tool: {
    style: {
      fill: "yellow"
    }
    style.border-radius: 10
    width: 120
    height: 40
  }
  out: {
    shape: circle
    width: 60
    height: 60
    style: {
      stroke: "black"
      fill: "white"
      font-color: "black"
      double-border: true
    }
  }
  in: {
    shape: circle
    width: 60
    height: 60
    style: {
      stroke: "black"
      fill: "white"
      font-color: "black"
      double-border: false
    }
  }
  io_call: {
    style: {
      animated: true
    }
  }
  prompt: {
    shape: page
    style: {
      fill: "#E6F7FF"
    }
    width: 60
  }
  response: {
    shape: page
    style: {
      fill: "#E6F7FF"
      double-border: true
    }
    width: 60
  }
  pt: "Prompt Template" {
    shape: page
    width: 60
    style: {
      fill: "#E6F7FF"
      stroke-dash: 2
    }
  }
  code: {
    style: {
      fill: "white"
    }
  }
}

# Root styles
style: {
  fill: white
  border-radius: 2
  shadow: true
  stroke-width: 2
  stroke: lightgray
}

# Global edge styles
(*** -> ***)[*]: {
  style: {
    stroke: "gray"
    stroke-dash: 3
    animated: true
  }
}
(*** <- ***)[*]: {
  style: {
    stroke: red
    stroke-dash: 3
    animated: true
  }
}
(*** <-> ***)[*]: {
  style: {
    stroke: orange
    stroke-dash: 3
    animated: true
  }
}

# ─────────────────────────────────────────────
# Nodes
# ─────────────────────────────────────────────

user: "User" {
  class: in
}

ui: "Chat UI / API Layer\n(Streamlit)" {
  class: cont
}

# ── Input Guardrail ──────────────────────────
input_guard: "Input Guardrail" {
  class: cont

  pattern_match: "Pattern Matching\n(16 Injection Patterns)" {
    class: code
  }
  llm_classify: "LLM Safety\nClassifier" {
    class: agent
  }

  pattern_match -> llm_classify: "if no pattern hit"
}

# ── Agent Orchestrator (LangGraph StateGraph) ──
orchestrator: "Agent Orchestrator\n(LangGraph StateGraph)" {
  class: cont1

  read_memory: "Read Memory" {
    class: agent
  }
  classify_intent: "Intent Classifier\n(7 categories)" {
    class: agent
  }
  rewrite_query: "Query Rewriter\n(1-3 queries)" {
    class: agent
  }
  retrieve: "Retrieve\n(multi-query)" {
    class: agent
  }
  check_sufficiency: "Sufficiency\nCheck" {
    class: agent
  }
  route_tools: "Tool Router" {
    class: agent
  }
  synthesize: "Answer\nSynthesizer" {
    class: agent
  }
  self_check: "Self-Check\n(Grounding)" {
    class: agent
  }
  update_memory: "Update Memory\n(Preferences)" {
    class: agent
  }

  read_memory -> classify_intent -> rewrite_query
  rewrite_query -> retrieve -> check_sufficiency
  check_sufficiency -> route_tools: "if tools needed"
  check_sufficiency -> synthesize: "if sufficient"
  check_sufficiency -> rewrite_query: "retry (max 2)"
  route_tools -> synthesize
  synthesize -> self_check
}

# ── Agentic RAG Pipeline ────────────────────
rag: "RAG Pipeline" {
  class: cont

  embeddings: "Embedding\n(text-embedding-3-small)" {
    class: code
  }
  chroma: "ChromaDB\nVector Store" {
    class: tool
  }
  retrieval_guard: "Retrieval Guardrail\n(Access Level Filter)" {
    class: agent
  }

  embeddings -> chroma: "semantic search"
  chroma -> retrieval_guard: "filter chunks"
}

# ── Structured Tools ────────────────────────
tools: "Structured Tools" {
  class: cont_tools

  tool_guard: "Tool Guardrail\n(Action Whitelist)" {
    class: agent
  }
  hospital_db: "Hospital DB\n(SQLite)" {
    class: tool
  }
  appt_api: "Appointment\nMock API" {
    class: tool
  }

  tool_guard -> hospital_db: "safe actions"
  tool_guard -> appt_api: "confirmed actions"
}

# ── Output Guardrail ────────────────────────
output_guard: "Output Guardrail" {
  class: cont

  phi_removal: "PHI Redaction\n(Regex Patterns)" {
    class: agent
  }
  disclaimer: "Medical Disclaimer\nInjection" {
    class: agent
  }
  truncation: "Length\nTruncation" {
    class: code
  }

  phi_removal -> disclaimer -> truncation
}

# ── Memory System ───────────────────────────
memory: "Memory System" {
  class: cont

  short_term: "Short-term\n(In-memory Dict)" {
    class: code
  }
  long_term: "Long-term Prefs\n(SQLite)" {
    class: tool
  }
  policy: "Memory Policy\n(PII Blocking)" {
    class: agent
  }
}

# ── External ────────────────────────────────
audit: "Audit Logger\n(JSONL)" {
  class: code
  shape: page
}

final_answer: "Final\nAnswer" {
  class: out
}

# ─────────────────────────────────────────────
# Connections
# ─────────────────────────────────────────────

user -> ui: "message"
ui -> input_guard
input_guard -> orchestrator: "safe requests"
input_guard -> ui: "blocked: refusal"

orchestrator -> rag: "retrieve (rewritten queries)"
orchestrator -> tools: "tool query (intent-based)"
orchestrator -> output_guard: "draft answer"
orchestrator -> memory: "read / write"

rag -> orchestrator: "filtered chunks"
tools -> orchestrator: "structured data"
output_guard -> final_answer: "validated answer"
memory -> orchestrator: "conversation + preferences"

input_guard -> audit: "log"
output_guard -> audit: "log"
tools.tool_guard -> audit: "log"
memory.policy -> audit: "log"
orchestrator.self_check -> output_guard: "verified answer"
